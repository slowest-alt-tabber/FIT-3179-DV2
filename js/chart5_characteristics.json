
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/completion_atar_bands.csv"
  },
  "transform": [
    {
      "filter": "datum.duration_years == 9"
    },
    {
      "filter": "datum.atar_band != null && trim(datum.atar_band) != ''"
    },
    {
      "calculate": "datum.outcome == 'Completed, in any year' || datum.outcome == 'Completed' ? 'Completed' : (datum.outcome == 'Never came back after the first year' || datum.outcome == 'Never returned' ? 'Never returned' : (datum.outcome == 'Re-enrolled, but dropped out' || datum.outcome == 'Re-enrolled, then left' ? 'Re-enrolled, then left' : (datum.outcome == 'Still enrolled at the end of the period' || datum.outcome == 'Still enrolled' ? 'Still enrolled' : datum.outcome)))",
      "as": "outcome_display"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "rate",
          "as": "mean_rate"
        }
      ],
      "groupby": [
        "atar_band",
        "outcome_display"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "outcome_display",
          "type": "nominal",
          "title": "Outcome",
          "sort": [
            "Completed",
            "Never returned",
            "Re-enrolled, then left",
            "Still enrolled"
          ],
          "axis": {
            "labelAngle": -25,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "atar_band",
          "type": "nominal",
          "title": "Australian Tertiary Admission Rank band",
          "sort": [
            "30-49",
            "50-59",
            "60-69",
            "70-79",
            "80-89",
            "90-94",
            "95-100",
            "Not provided or not required"
          ],
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        "color": {
          "field": "mean_rate",
          "type": "quantitative",
          "title": "Mean published rate (%)",
          "scale": {
            "domain": [0, 100],
            "range": [
              "#FFFFFF",
              "#001f3f"
            ],
            "clamp": true
          }
        },
        "tooltip": [
          {
            "field": "atar_band",
            "title": "Australian Tertiary Admission Rank band"
          },
          {
            "field": "outcome_display",
            "title": "Outcome"
          },
          {
            "field": "mean_rate",
            "title": "Mean nine-year rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.atar_band == '95-100' && datum.outcome_display == 'Completed'"
        },
        {
          "calculate": "format(datum.mean_rate, '.0f') + '%'",
          "as": "annotation_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "outcome_display",
          "type": "nominal",
          "sort": [
            "Completed",
            "Never returned",
            "Re-enrolled, then left",
            "Still enrolled"
          ]
        },
        "y": {
          "field": "atar_band",
          "type": "nominal",
          "sort": [
            "30-49",
            "50-59",
            "60-69",
            "70-79",
            "80-89",
            "90-94",
            "95-100",
            "Not provided or not required"
          ]
        },
        "text": {
          "field": "annotation_label"
        },
        "tooltip": [
          {
            "field": "atar_band",
            "title": "Australian Tertiary Admission Rank band"
          },
          {
            "field": "mean_rate",
            "title": "Mean nine-year rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}
