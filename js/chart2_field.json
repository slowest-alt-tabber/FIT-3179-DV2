{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/completion_field_of_education.csv"
  },
  "transform": [
    {
      "filter": "datum.duration_years == 9"
    },
    {
      "filter": "datum.field_of_education != null && datum.field_of_education != ''"
    },
    {
      "filter": "datum.rate != null && (datum.outcome == 'Completed, in any year' || datum.outcome == 'Completed')"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "rate",
          "as": "mean_rate"
        }
      ],
      "groupby": ["field_of_education"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "field_of_education",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "labelLimit": 240,
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "mean_rate",
          "type": "quantitative",
          "title": "Nine-year completion rate (%)",
          "scale": {
            "domain": [0, 100]
          },
          "axis": {
            "gridColor": "#E3E7EB"
          }
        },
        "color": {
          "field": "mean_rate",
          "type": "quantitative",
          "title": "Completion rate (%)",
          "scale": {
            "domain": [0, 100],
            "range": ["#F3F4F6", "#263746"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "field_of_education",
            "title": "Field of education"
          },
          {
            "field": "mean_rate",
            "title": "Mean nine-year completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "mean_rate",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        },
        {
          "calculate": "format(datum.mean_rate, '.1f') + '%'",
          "as": "value_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#263746"
      },
      "encoding": {
        "x": {
          "field": "mean_rate",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        "y": {
          "field": "field_of_education",
          "type": "nominal",
          "sort": "-x"
        },
        "text": {
          "field": "value_label"
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "mean_rate",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        },
        {
          "calculate": "format(datum.mean_rate, '.1f') + '%'",
          "as": "value_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#263746"
      },
      "encoding": {
        "x": {
          "field": "mean_rate",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        "y": {
          "field": "field_of_education",
          "type": "nominal",
          "sort": "-x"
        },
        "text": {
          "field": "value_label"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}