{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/completion_field_of_education.csv"
  },
  "transform": [
    {
      "filter": "datum.duration_years == 9"
    },
    {
      "filter": "datum.field_of_education != null && datum.field_of_education != ''"
    },
    {
      "filter": "datum.rate != null && (datum.outcome == 'Completed, in any year' || datum.outcome == 'Completed')"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "rate",
          "as": "mean_rate"
        }
      ],
      "groupby": ["field_of_education"]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "field_of_education",
      "type": "nominal",
      "title": "Field of Education",
      "sort": "-x",
      "axis": {
        "labelLimit": 250,
        "labelFontSize": 10
      }
    },
    "x": {
      "field": "mean_rate",
      "type": "quantitative",
      "title": "Nine-year completion rate (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "gridColor": "#E1E6EA"
      }
    },
    
    "color": {
      "field": "mean_rate",
      "type": "quantitative",
      "title": "Completion rate (%)",
      "scale": {
        "type": "linear",
        "domain": [0, 50, 100],
        "clamp": true,
        "range": [
          "#D9F0EE",
          "#66B2A8",
          "#005B50"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "field_of_education",
        "title": "Field of education"
      },
      {
        "field": "mean_rate",
        "title": "Mean nine-year completion rate (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D",
      "gridColor": "#E1E6EA"
    }
  }
}