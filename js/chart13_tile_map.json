{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "projection": {
    "type": "mercator",
    "center": [134, -26],
    "scale": 520
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/disability_completion_rates.csv"
        },
        "key": "state",
        "fields": [
          "disability_completion_rate"
        ]
      }
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/qilt_tile_map.csv"
        },
        "key": "state",
        "fields": [
          "mean_rating",
          "university_count"
        ]
      }
    },
    {
      "calculate": "isValid(datum.mean_rating) ? (datum.disability_completion_rate < 52 ? (datum.mean_rating < 70 ? '0-0' : datum.mean_rating < 73 ? '0-1' : '0-2') : datum.disability_completion_rate < 58 ? (datum.mean_rating < 70 ? '1-0' : datum.mean_rating < 73 ? '1-1' : '1-2') : (datum.mean_rating < 70 ? '2-0' : datum.mean_rating < 73 ? '2-1' : '2-2')) : 'missing'",
      "as": "bivariate_key"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "bivariate_key",
      "type": "nominal",
      "title": "Completion and support",
      "scale": {
        "domain": [
          "0-0",
          "0-1",
          "0-2",
          "1-0",
          "1-1",
          "1-2",
          "2-0",
          "2-1",
          "2-2",
          "missing"
        ],
        "range": [
          "#E8E8E8",
          "#ACE4E4",
          "#5AC8C8",
          "#DFB0D6",
          "#A5ADD3",
          "#5698B9",
          "#BE64AC",
          "#8C62AA",
          "#3B4994",
          "#D9E0E6"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "disability_completion_rate",
        "type": "quantitative",
        "title": "Completion among students with disability (%)",
        "format": ".1f"
      },
      {
        "field": "mean_rating",
        "type": "quantitative",
        "title": "Mean positive support rating (%)",
        "format": ".1f"
      },
      {
        "field": "university_count",
        "type": "quantitative",
        "title": "Providers represented"
      }
    ]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}