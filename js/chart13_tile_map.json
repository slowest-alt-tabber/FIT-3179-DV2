
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Non-contiguous cartogram resizing Australian state areas by completion rates among students with disability.",
  "background": "white",
  "padding": {
    "top": 8,
    "bottom": 4,
    "left": 4,
    "right": 4
  },
  "vconcat": [
    {
      "width": "container",
      "height": 340,
      "projection": {
        "type": "mercator",
        "fit": {
          "expr": "data('cartogram_features')"
        },
        "clipAngle": null
      },
      "data": {
        "name": "cartogram_features",
        "url": "data/disability_completion_cartogram.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "fillOpacity": 0.92
      },
      "encoding": {
        
      "color": {
        "field": "properties.disability_completion_rate",
        "type": "quantitative",
        "title": "Completion rate (%)",
        "scale": {
          "type": "linear",
          "domain": [0, 50, 100],
          "clamp": true,
          "range": [
            "#F3E5F5",
            "#8E24AA",
            "#311B92"
          ]
        },
        "legend": {
          "orient": "bottom",
          "direction": "horizontal",
          "gradientLength": 220,
          "values": [0, 25, 50, 75, 100],
          "format": ".0f",
          "titleFontSize": 11,
          "labelFontSize": 10,
          "offset": 4
        }
      },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "properties.disability_completion_rate",
            "type": "quantitative",
            "title": "Completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "width": "container",
      "height": 94,
      "title": {
        "text": "Size scaling",
        "subtitle": "Larger squares represent larger completion-rate weights.",
        "anchor": "start",
        "fontSize": 12,
        "subtitleFontSize": 10,
        "offset": 3
      },
      "data": {
        "values": [
          {"rate": 25, "row": 0.5},
          {"rate": 50, "row": 0.5},
          {"rate": 75, "row": 0.5},
          {"rate": 100, "row": 0.5}
        ]
      },
      
      "mark": {
        "type": "point",
        "shape": "square",
        "filled": true,
        "color": "#455A64",
        "stroke": "#263238",
        "strokeWidth": 1
      }
      ,
      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "domain": [-10, 110],
            "nice": false
          },
          "axis": {
            "title": "Completion-rate weight (%)",
            "values": [0, 25, 50, 75, 100],
            "format": ".0f",
            "grid": false,
            "labelFontSize": 10,
            "titleFontSize": 11,
            "labelPadding": 3,
            "titlePadding": 5
          }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "size": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "range": [0, 700]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Completion-rate weight (%)",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "spacing": 4,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D",
      "gridColor": "#E8EEEE",
      "domainColor": "#D6DFDF",
      "tickColor": "#D6DFDF"
    },
    "title": {
      "font": "Inter",
      "fontSize": 13,
      "anchor": "start",
      "color": "#24313D",
      "subtitleFont": "Inter",
      "subtitleFontSize": 11,
      "subtitleColor": "#596873"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D"
    }
  }
}
