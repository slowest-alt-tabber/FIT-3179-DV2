
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 520
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F3F6",
        "stroke": "#CBD5DE",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Western Australia",
            "longitude": 121.5,
            "latitude": -25.5
          },
          {
            "state": "Northern Territory",
            "longitude": 133.5,
            "latitude": -19
          },
          {
            "state": "South Australia",
            "longitude": 136.5,
            "latitude": -30
          },
          {
            "state": "Queensland",
            "longitude": 145.5,
            "latitude": -22
          },
          {
            "state": "New South Wales",
            "longitude": 147,
            "latitude": -32
          },
          {
            "state": "Victoria",
            "longitude": 145.5,
            "latitude": -36.5
          },
          {
            "state": "Tasmania",
            "longitude": 146.5,
            "latitude": -42
          },
          {
            "state": "Australian Capital Territory",
            "longitude": 149.1,
            "latitude": -35.3
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/disability_completion_rates.csv"
            },
            "key": "state",
            "fields": [
              "disability_completion_rate"
            ]
          }
        },
        {
          "filter": "isValid(datum.disability_completion_rate)"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.76,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "disability_completion_rate",
          "type": "quantitative",
          "title": "Completion rate",
          "scale": {
            "domain": [0, 100],
            "range": [100, 1800],
            "zero": true
          },
          "legend": null
        },
        "color": {
          "field": "disability_completion_rate",
          "type": "quantitative",
          "title": "Completion among students with disability (%)",
          "scale": {
            "domain": [0, 100],
            "range": ["#F3F4F6", "#404854"],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "title": "Completion rate (%)"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "disability_completion_rate",
            "title": "Completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/disability_completion_rates.csv"
      },
      "transform": [
        {
          "filter": "datum.state == 'Victoria' || datum.state == 'Queensland'"
        },
        {
          "calculate": "format(datum.disability_completion_rate, '.1f') + '%'",
          "as": "annotation_label"
        },
        {
          "calculate": "datum.state == 'Victoria' ? 145.5 : 145.5",
          "as": "longitude"
        },
        {
          "calculate": "datum.state == 'Victoria' ? -36.5 : -22",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -18,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#24313D",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation_label"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "disability_completion_rate",
            "title": "Completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}
