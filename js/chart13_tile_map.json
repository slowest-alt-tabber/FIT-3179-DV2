{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/disability_completion_rates.csv",
    "format": {
      "type": "csv",
      "parse": {
        "col": "number",
        "row": "number",
        "disability_completion_rate": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 5
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "title": null,
          "axis": null,
          "sort": [0, 1, 2, 3, 4, 5],
          "scale": {
            "domain": [0, 1, 2, 3, 4, 5],
            "paddingInner": 0.08
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "title": null,
          "axis": null,
          "sort": [0, 1, 2, 3, 4],
          "scale": {
            "domain": [0, 1, 2, 3, 4],
            "paddingInner": 0.08
          }
        },
        "color": {
          "field": "disability_completion_rate",
          "type": "quantitative",
          "title": "Completion rate (%)",
          "scale": {
            "domain": [0, 100],
            "range": ["#F3F4F6", "#3B2F2F"],
            "clamp": true
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "disability_completion_rate",
            "type": "quantitative",
            "title": "Completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Victoria' || datum.state == 'Queensland'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "transparent",
        "stroke": "#D55E00",
        "strokeWidth": 2.5,
        "cornerRadius": 5
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4, 5],
          "scale": {
            "domain": [0, 1, 2, 3, 4, 5],
            "paddingInner": 0.08
          },
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4],
          "scale": {
            "domain": [0, 1, 2, 3, 4],
            "paddingInner": 0.08
          },
          "axis": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#263746",
        "dy": -7
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4, 5],
          "scale": {
            "domain": [0, 1, 2, 3, 4, 5],
            "paddingInner": 0.08
          },
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4],
          "scale": {
            "domain": [0, 1, 2, 3, 4],
            "paddingInner": 0.08
          },
          "axis": null
        },
        "text": {
          "field": "state_abbr"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Victoria' || datum.state == 'Queensland'"
        },
        {
          "calculate": "format(datum.disability_completion_rate, '.1f') + '%'",
          "as": "annotation_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "white",
        "strokeWidth": 1,
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4, 5],
          "scale": {
            "domain": [0, 1, 2, 3, 4, 5],
            "paddingInner": 0.08
          },
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": [0, 1, 2, 3, 4],
          "scale": {
            "domain": [0, 1, 2, 3, 4],
            "paddingInner": 0.08
          },
          "axis": null
        },
        "text": {
          "field": "annotation_label"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "disability_completion_rate",
            "title": "Completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}