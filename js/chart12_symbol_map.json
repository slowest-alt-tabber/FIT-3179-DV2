{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "projection": {
    "type": "mercator",
    "center": [134, -26],
    "scale": 500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EDF2",
        "stroke": "#BBC6CF",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/qilt_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "datum.indicator == 'Student Support and Services' && datum.longitude != null && datum.latitude != null && datum.positive_percent != null"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 170,
        "opacity": 0.62,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        
        "color": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Student support rating (%)",
          "scale": {
            "type": "linear",
            "domain": [0, 50, 100],
            "clamp": true,
            "range": [
              "#FCE4EC",
              "#E573A5",
              "#880E4F"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": "Student support rating (%)"
          }
        },
        "tooltip": [
          {
            "field": "provider",
            "title": "University"
          },
          {
            "field": "campus_name",
            "title": "Campus"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "positive_percent",
            "title": "Student support rating (%)",
            "format": ".1f"
          },
          {
            "field": "survey_year",
            "title": "Survey year"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 10,
      "titleFontSize": 11
    }
  }
}