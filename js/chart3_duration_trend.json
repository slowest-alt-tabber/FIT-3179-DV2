
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt_slopegraph_study_level.csv"
  },
  "transform": [
    {
      "calculate": "datum.indicator == 'Skills Development' ? 'Skills Development' : datum.indicator == 'Peer Engagement' ? 'Peer Engagement' : datum.indicator == 'Teaching Quality and Engagement' ? 'Teaching Quality and Engagement' : datum.indicator == 'Student Support and Services' ? 'Student Support and Services' : datum.indicator == 'Learning Resources' ? 'Learning Resources' : 'Overall Educational Experience'",
      "as": "indicator_display"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "title": "Study level",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ],
          "axis": {
            "labelFontSize": 11,
            "labelFontWeight": "bold",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [0, 100]
          },
          "axis": {
            "values": [0, 20, 40, 60, 80, 100],
            "gridColor": "#E1E6EA"
          }
        },
        
        "color": {
          "field": "indicator_display",
          "type": "nominal",
          "title": "Experience measure",
          "scale": {
            "domain": [
              "Skills Development",
              "Peer Engagement",
              "Teaching Quality and Engagement",
              "Student Support and Services",
              "Learning Resources",
              "Overall Educational Experience"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#D55E00",
              "#56B4E9",
              "#CC79A7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "title": "Experience measure"
          }
        },
        "detail": {
          "field": "indicator_display"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 68
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ]
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        
        "color": {
          "field": "indicator_display",
          "type": "nominal",
          "title": "Experience measure",
          "scale": {
            "domain": [
              "Skills Development",
              "Peer Engagement",
              "Teaching Quality and Engagement",
              "Student Support and Services",
              "Learning Resources",
              "Overall Educational Experience"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#D55E00",
              "#56B4E9",
              "#CC79A7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "title": "Experience measure"
          }
        },
        "tooltip": [
          {
            "field": "study_level",
            "title": "Study level"
          },
          {
            "field": "indicator",
            "title": "Full experience measure"
          },
          {
            "field": "positive_percent",
            "title": "Positive rating (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.indicator == 'Overall Educational Experience' && datum.study_level == 'Undergraduate'"
        },
        {
          "calculate": "format(datum.positive_percent, '.1f') + '%'",
          "as": "rating_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -8,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#CC79A7"
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ]
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        "text": {
          "field": "rating_label"
        },
        "tooltip": [
          {
            "field": "study_level",
            "title": "Study level"
          },
          {
            "field": "positive_percent",
            "title": "Positive rating (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.indicator == 'Overall Educational Experience' && datum.study_level == 'Postgraduate coursework'"
        },
        {
          "calculate": "format(datum.positive_percent, '.1f') + '%'",
          "as": "rating_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#CC79A7"
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ]
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        "text": {
          "field": "rating_label"
        },
        "tooltip": [
          {
            "field": "study_level",
            "title": "Study level"
          },
          {
            "field": "positive_percent",
            "title": "Positive rating (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D",
      "gridColor": "#E1E6EA"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 10,
      "titleFontSize": 11
    }
  }
}
