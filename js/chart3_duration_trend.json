{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt_slopegraph_study_level.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "title": null,
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ],
          "axis": {
            "labelFontSize": 11,
            "labelFontWeight": "bold",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [50, 90]
          },
          "axis": {
            "gridColor": "#E3E7EB"
          }
        },
        "color": {
          "field": "indicator",
          "type": "nominal",
          "title": "Experience indicator",
          "scale": {
            "domain": [
              "Skills Development",
              "Peer Engagement",
              "Teaching Quality and Engagement",
              "Student Support and Services",
              "Learning Resources",
              "Overall Educational Experience"
            ],
            "range": [
              "#332288",
              "#88CCEE",
              "#44AA99",
              "#999933",
              "#CC6677",
              "#AA4499"
            ]
          }
        },
        "detail": {
          "field": "indicator"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ]
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "scale": {
            "domain": [50, 90]
          }
        },
        "color": {
          "field": "indicator",
          "type": "nominal",
          "scale": {
            "domain": [
              "Skills Development",
              "Peer Engagement",
              "Teaching Quality and Engagement",
              "Student Support and Services",
              "Learning Resources",
              "Overall Educational Experience"
            ],
            "range": [
              "#332288",
              "#88CCEE",
              "#44AA99",
              "#999933",
              "#CC6677",
              "#AA4499"
            ]
          }
        },
        "tooltip": [
          {
            "field": "study_level",
            "title": "Study level"
          },
          {
            "field": "indicator",
            "title": "Experience indicator"
          },
          {
            "field": "positive_percent",
            "title": "Positive rating (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.indicator == 'Overall Educational Experience'"
        },
        {
          "calculate": "format(datum.positive_percent, '.1f') + '%'",
          "as": "rating_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -12,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#AA4499"
      },
      "encoding": {
        "x": {
          "field": "study_level",
          "type": "nominal",
          "sort": [
            "Undergraduate",
            "Postgraduate coursework"
          ]
        },
        "y": {
          "field": "positive_percent",
          "type": "quantitative",
          "scale": {
            "domain": [50, 90]
          }
        },
        "text": {
          "field": "rating_label"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 10
    }
  }
}