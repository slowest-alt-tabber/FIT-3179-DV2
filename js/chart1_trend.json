{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/completion_national_trend.csv"
  },
  "transform": [
    {
      "filter": "datum.cohort_type == 'Domestic Students'"
    },
    {
      "filter": "datum.rate != null && (datum.outcome == 'Completed, in any year' || datum.outcome == 'Completed')"
    },
    {
      "calculate": "datum.duration_years == 4 ? 'Four years' : datum.duration_years == 6 ? 'Six years' : datum.duration_years == 9 ? 'Nine years' : datum.duration_label",
      "as": "duration_display"
    },
    {
      "filter": "datum.duration_display == 'Four years' || datum.duration_display == 'Six years' || datum.duration_display == 'Nine years'"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "rate",
          "as": "mean_rate"
        }
      ],
      "groupby": ["timeframe", "duration_display"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 42
        },
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "timeframe",
          "type": "nominal",
          "title": "Published cohort period",
          "sort": "ascending",
          "axis": {
            "labelAngle": -45,
            "labelFontSize": 10,
            "labelLimit": 100
          }
        },
        "y": {
          "field": "mean_rate",
          "type": "quantitative",
          "title": "Completion rate (%)",
          "scale": {
            "domain": [0, 100]
          }
        },
        "color": {
          "field": "duration_display",
          "type": "nominal",
          "title": "Follow-up period",
          "scale": {
            "domain": ["Four years", "Six years", "Nine years"],
            "range": ["#0072B2", "#E69F00", "#009E73"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "title": "Follow-up period",
            "labelLimit": 120
          }
        },
        "detail": {
          "field": "duration_display"
        },
        "tooltip": [
          {
            "field": "timeframe",
            "title": "Cohort period"
          },
          {
            "field": "duration_display",
            "title": "Follow-up period"
          },
          {
            "field": "mean_rate",
            "title": "Mean completion rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "latest_rank"
            }
          ],
          "groupby": ["duration_display"],
          "sort": [
            {
              "field": "timeframe",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.latest_rank == 1"
        },
        {
          "calculate": "format(datum.mean_rate, '.0f') + '%'",
          "as": "endpoint_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "timeframe",
          "type": "nominal",
          "sort": "ascending"
        },
        "y": {
          "field": "mean_rate",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
        },
        "color": {
          "field": "duration_display",
          "type": "nominal",
          "scale": {
            "domain": ["Four years", "Six years", "Nine years"],
            "range": ["#0072B2", "#E69F00", "#009E73"]
          },
          "legend": null
        },
        "detail": {
          "field": "duration_display"
        },
        "text": {
          "field": "endpoint_label"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D",
      "gridColor": "#E1E6EA"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 10,
      "titleFontSize": 11
    }
  }
}