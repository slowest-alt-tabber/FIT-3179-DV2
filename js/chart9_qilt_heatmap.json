{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt_study_areas.csv"
  },
  "transform": [
    {
      "filter": "datum.positive_percent != null"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": "Experience indicator",
          "sort": [
            "Skills Development",
            "Peer Engagement",
            "Teaching Quality and Engagement",
            "Student Support and Services",
            "Learning Resources",
            "Overall Educational Experience"
          ],
          "axis": {
            "labelAngle": -35,
            "labelLimit": 150,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "study_area",
          "type": "nominal",
          "title": "Study area",
          "sort": "ascending",
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        
        "color": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "type": "linear",
            "domain": [0, 50, 100],
            "clamp": true,
            "range": [
              "#F4F7E8",
              "#A3B86C",
              "#3F6212"
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Positive rating (%)"
          }
        },
        "tooltip": [
          {
            "field": "study_area",
            "title": "Study area"
          },
          {
            "field": "indicator",
            "title": "Indicator"
          },
          {
            "field": "positive_percent",
            "title": "Positive rating (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}