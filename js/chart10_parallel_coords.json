  {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 330,
    "autosize": { "type": "fit", "contains": "padding" },
    "background": "white",
    "data": {
      "url": "data/qilt_study_areas.csv"
    },
    "transform": [
      { "filter": "datum.positive_percent != null && datum.study_area != null" }
    ],
    "mark": {
      "type": "line",
      "strokeWidth": 1.1,
      "opacity": 0.25
    },
    "encoding": {
      "x": {
        "field": "indicator",
        "type": "nominal",
        "title": "Experience indicator",
        "axis": { "labelAngle": -35 },
        "sort": [
          "Skills Development",
          "Peer Engagement",
          "Teaching Quality and Engagement",
          "Student Support and Services",
          "Learning Resources",
          "Overall Educational Experience"
        ]
      },
      "y": {
        "field": "positive_percent",
        "type": "quantitative",
        "title": "Positive rating (%)",
        "scale": { "domain": [0, 100] }
      },
      "detail": { "field": "study_area" },
      "color": { "value": "#4978a8" },
      "tooltip": [
        { "field": "study_area", "title": "Study Area" },
        { "field": "indicator", "title": "Indicator" },
        { "field": "positive_percent", "title": "Rating (%)", "format": ".1f" }
      ]
    }
  }