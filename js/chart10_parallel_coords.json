
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranks of undergraduate student experience measures across survey years.",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt_experience_ranks.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 38
        }
      },
      "encoding": {
        "x": {
          "field": "survey_year",
          "type": "quantitative",
          "title": "Survey year",
          "scale": {
            "domain": [2017, 2025]
          },
          "axis": {
            "values": [
              2017, 2018, 2019,
              2020, 2021, 2022,
              2023, 2024, 2025
            ],
            "format": "d",
            "labelAngle": -35,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "indicator_rank",
          "type": "quantitative",
          "title": "Rank (one is highest)",
          "scale": {
            "domain": [6, 1]
          },
          "axis": {
            "values": [1, 2, 3, 4, 5, 6],
            "gridColor": "#E1E6EA"
          }
        },
        "color": {
          "field": "indicator",
          "type": "nominal",
          "title": "Experience measure",
          "scale": {
            "domain": [
              "Skills Development",
              "Peer Engagement",
              "Teaching Quality and Engagement",
              "Student Support and Services",
              "Learning Resources",
              "Overall Educational Experience"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#D55E00",
              "#56B4E9",
              "#CC79A7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "title": "Experience measure"
          }
        },
        "detail": {
          "field": "indicator"
        },
        "tooltip": [
          {
            "field": "survey_year",
            "type": "quantitative",
            "title": "Survey year",
            "format": "d"
          },
          {
            "field": "indicator",
            "type": "nominal",
            "title": "Full experience measure"
          },
          {
            "field": "mean_rating",
            "type": "quantitative",
            "title": "Mean positive rating (%)",
            "format": ".1f"
          },
          {
            "field": "indicator_rank",
            "type": "quantitative",
            "title": "Ranking",
            "format": "d"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#24313D",
      "titleColor": "#24313D",
      "gridColor": "#E1E6EA"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 9,
      "titleFontSize": 10
    }
  }
}
