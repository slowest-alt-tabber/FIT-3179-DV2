
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "University positive ratings for overall educational experience in 2017 and 2025.",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt_dumbbell.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#ADB5BD",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "provider",
          "type": "nominal",
          "title": "University",
          "sort": "-x",
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "rating_2017",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [0, 100]
          },
          "axis": {
            "format": ".0f",
            "gridColor": "#E3E7EB"
          }
        },
        "x2": {
          "field": "rating_2025"
        },
        "tooltip": [
          {
            "field": "provider",
            "type": "nominal",
            "title": "University"
          },
          {
            "field": "rating_2017",
            "type": "quantitative",
            "title": "2017 rating (%)",
            "format": ".1f"
          },
          {
            "field": "rating_2025",
            "type": "quantitative",
            "title": "2025 rating (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "rating_2017",
            "rating_2025"
          ],
          "as": [
            "rating_field",
            "positive_percent"
          ]
        },
        {
          "calculate": "datum.rating_field === 'rating_2017' ? '2017' : '2025'",
          "as": "survey_year"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "y": {
          "field": "provider",
          "type": "nominal",
          "title": "University",
          "sort": {
            "field": "rating_2025",
            "order": "descending"
          },
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [0, 100]
          }
        },
        "color": {
          "field": "survey_year",
          "type": "nominal",
          "title": "Survey year",
          "scale": {
            "domain": ["2017", "2025"],
            "range": ["#756BB1", "#008B8B"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Survey year"
          }
        },
        "tooltip": [
          {
            "field": "provider",
            "type": "nominal",
            "title": "University"
          },
          {
            "field": "survey_year",
            "type": "nominal",
            "title": "Survey year"
          },
          {
            "field": "positive_percent",
            "type": "quantitative",
            "title": "Overall experience (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}
