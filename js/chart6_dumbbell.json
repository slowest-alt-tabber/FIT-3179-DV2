{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "data": {
    "url": "data/qilt.csv"
  },
  "transform": [
    {
      "filter": "datum.row_type == 'provider' && datum.indicator == 'Overall Educational Experience' && datum.positive_percent != null"
    },
    {
      "filter": "datum.survey_year == 2017 || datum.survey_year == 2025"
    },
    {
      "pivot": "survey_year",
      "value": "positive_percent",
      "groupby": ["provider"]
    },
    {
      "filter": "datum['2017'] != null && datum['2025'] != null"
    },
    {
      "fold": ["2017", "2025"],
      "as": ["survey_year", "positive_percent"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#ADB5BD",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "provider",
          "type": "nominal",
          "title": "University",
          "sort": "-x",
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "2017",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [0, 100]
          }
        },
        "x2": {
          "field": "2025"
        },
        "tooltip": [
          {
            "field": "provider",
            "title": "University"
          },
          {
            "field": "2017",
            "title": "2017 rating (%)",
            "format": ".1f"
          },
          {
            "field": "2025",
            "title": "2025 rating (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "y": {
          "field": "provider",
          "type": "nominal",
          "title": "University",
          "sort": "-x",
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 10
          }
        },
        "x": {
          "field": "positive_percent",
          "type": "quantitative",
          "title": "Positive rating (%)",
          "scale": {
            "domain": [0, 100]
          }
        },
        "color": {
          "field": "survey_year",
          "type": "nominal",
          "title": "Survey year",
          "scale": {
            "domain": ["2017", "2025"],
            "range": ["#756BB1", "#008B8B"]
          }
        },
        "tooltip": [
          {
            "field": "provider",
            "title": "University"
          },
          {
            "field": "survey_year",
            "title": "Survey year"
          },
          {
            "field": "positive_percent",
            "title": "Overall experience (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263746",
      "titleColor": "#263746",
      "gridColor": "#E3E7EB",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}