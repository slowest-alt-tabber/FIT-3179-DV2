{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "projection": {
    "type": "mercator",
    "center": [134, -26],
    "scale": 500
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/qilt_tile_map.csv"
        },
        "key": "state",
        "fields": [
          "mean_rating",
          "university_count",
          "indicator"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 0.9
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.mean_rating)",
        "field": "mean_rating",
        "type": "quantitative",
        "title": "Support rating (%)",
        "scale": {
          "domain": [0, 100],
          "range": ["#d1eee7", "#023020"],
          "clamp": true
        }
      },
      "value": "#D9E0E6"
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "mean_rating",
        "type": "quantitative",
        "title": "Mean support rating (%)",
        "format": ".1f"
      },
      {
        "field": "university_count",
        "type": "quantitative",
        "title": "Providers represented"
      },
      {
        "field": "indicator",
        "type": "nominal",
        "title": "Survey indicator"
      }
    ]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}